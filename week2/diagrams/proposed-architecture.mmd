%%{ init: { 'theme': 'base', 'themeVariables': { 'primaryColor': '#E8F0FE', 'primaryTextColor': '#1A73E8', 'primaryBorderColor': '#1967D2', 'lineColor': '#4285F4' } } }%%
graph TB
    subgraph LOADTEST["Load Testing Tier"]
        K6["Grafana k6<br/>Load Generator"]
        K6_STAGES["Execution Stages:<br/>1. Warmup: 20 VUs (1m)<br/>2. Flash Surge: 150 VUs (30s)<br/>3. Sustained Peak: 150 VUs (5m)<br/>4. Flash Spike: 500 VUs (2m)<br/>5. Cooldown: 20 VUs (5m)"]
    end

    subgraph GCP["Google Cloud Platform (GCP) — asia-south1 (Mumbai) Region"]
        subgraph NETWORKING["Traffic Management Layer"]
            GCLB["Google Cloud Load Balancing<br/>(External Application Load Balancer)"]
            HC["HTTP Health Check<br/>GET /health:3000<br/>Interval: 15s | Threshold: 2"]
        end

        subgraph MIG_GROUP["Compute Engine Managed Instance Group (MIG)"]
            direction LR
            subgraph VM1["GCE VM 1 (e2-medium)"]
                D1["Docker Container<br/>MyntraFlash App<br/>Node.js + Express"]
            end
            subgraph VM2["GCE VM 2 (e2-medium)"]
                D2["Docker Container<br/>MyntraFlash App<br/>Node.js + Express"]
            end
            subgraph VM3["GCE VM 3 (e2-medium)<br/>(Autoscaled)"]
                D3["Docker Container<br/>MyntraFlash App<br/>Node.js + Express"]
            end
        end

        subgraph AUTOSCALE["Compute Engine MIG Autoscaler"]
            RULES["Autoscaling Policy"]
            SO["Scale-Out Trigger:<br/>Fleet Avg CPU > 70%<br/>Add 1 Instance"]
            SI["Scale-In Control:<br/>Fleet Avg CPU < 30%<br/>Remove 1 Instance"]
            COOL["Cool-Down Period: 300s (5m)<br/>Min: 1 Instance | Max: 3 Instances"]
            RULES --- SO
            RULES --- SI
            RULES --- COOL
        end

        subgraph MONITOR["Cloud Observability Layer"]
            GCM["Google Cloud Monitoring<br/>& Cloud Logging"]
            METRICS["Platform Telemetry:<br/>• compute/instance/cpu/utilization<br/>• loadbalancing/https/request_count<br/>• loadbalancing/https/total_latencies"]
        end

        subgraph REGISTRY["Artifact Registry"]
            GHCR["GitHub Container<br/>Registry (ghcr.io)"]
        end
    end

    subgraph APP_ENDPOINTS["MyntraFlash Application Endpoints"]
        direction LR
        E1["GET /products<br/>Product Catalogue"]
        E2["GET /flash-sale<br/>Flash Sale Items"]
        E3["GET /api/discount<br/>Discount Pricing API"]
        E4["GET /api/recommend<br/>Recommendations API"]
        E5["GET /health<br/>Health Check Probe"]
        E6["GET /instance-id<br/>Node Metadata"]
    end

    K6 -->|"Synthetic HTTP Requests"| GCLB
    GCLB -->|"Round-Robin Distribution"| VM1
    GCLB -->|"Round-Robin Distribution"| VM2
    GCLB -->|"Round-Robin Distribution"| VM3
    HC -->|"Poll Vitality"| D1
    HC -->|"Poll Vitality"| D2
    HC -->|"Poll Vitality"| D3
    GCLB --- HC
    GHCR -->|"Docker Pull via Startup Script"| VM1
    GHCR -->|"Docker Pull via Startup Script"| VM2
    GHCR -->|"Docker Pull via Startup Script"| VM3
    GCM -->|"Target Metric Signal"| RULES
    VM1 -->|"Export Telemetry"| GCM
    VM2 -->|"Export Telemetry"| GCM
    VM3 -->|"Export Telemetry"| GCM
    D1 --- E1
    D1 --- E2
    D1 --- E3
    D1 --- E4
    D1 --- E5
    D1 --- E6

    classDef loadtest fill:#FFF9C4,stroke:#F9A825,color:#F57F17
    classDef lb fill:#E8F0FE,stroke:#1A73E8,color:#0D47A1
    classDef vm fill:#E6F4EA,stroke:#137333,color:#0D652D
    classDef autoscale fill:#FCE8E6,stroke:#C5221F,color:#B31412
    classDef monitor fill:#F3E8FD,stroke:#7627BB,color:#5A1A9A
    classDef registry fill:#E0F7FA,stroke:#00838F,color:#006064
    classDef endpoints fill:#F8F9FA,stroke:#5F6368,color:#202124

    class K6,K6_STAGES loadtest
    class GCLB,HC lb
    class VM1,VM2,VM3,D1,D2,D3 vm
    class RULES,SO,SI,COOL autoscale
    class GCM,METRICS monitor
    class GHCR registry
    class E1,E2,E3,E4,E5,E6 endpoints
