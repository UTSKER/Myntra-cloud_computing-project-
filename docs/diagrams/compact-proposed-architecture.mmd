%%{ init: { 'theme': 'base', 'themeVariables': { 'primaryColor': '#E8F0FE', 'primaryTextColor': '#1A73E8', 'primaryBorderColor': '#1967D2', 'lineColor': '#4285F4', 'fontSize': '14px' } } }%%
flowchart LR
    %% Column 1: Client
    subgraph T1["1. Load Testing"]
        K6["<b>Grafana k6</b><br/>Load Generator"]
    end

    %% Column 2: Gateway
    subgraph T2["2. Cloud Gateway"]
        LB["<b>Google Cloud Load Balancer</b><br/>External HTTP (Port 80)<br/><i>Round-Robin Routing</i>"]
    end

    %% Column 3: Compute Cluster (MIG)
    subgraph T3["3. Compute Engine MIG (asia-south1 Mumbai)"]
        direction TB
        VM1["<b>VM 1 (e2-medium)</b><br/>Docker: Node.js App"]
        VM2["<b>VM 2 (e2-medium)</b><br/>Docker: Node.js App"]
        VM3["<b>VM 3 (e2-medium)</b><br/>⚡ <i>Autoscaled Node</i>"]
    end

    %% Column 4: Control & Registry
    subgraph T4["4. Management & Scaling"]
        direction TB
        AUTO["<b>MIG Autoscaler</b><br/>Target: CPU > 70%"]
        MON["<b>Cloud Monitoring</b><br/>Metrics & Health"]
        GHCR["<b>GitHub Registry</b><br/>ghcr.io Container"]
    end

    %% Connections
    K6 -->|"HTTP Load"| LB
    LB -->|"50% Traffic"| VM1
    LB -->|"50% Traffic"| VM2
    LB -.->|"Peak Spike"| VM3

    GHCR -.->|"Image Pull"| T3
    T3 -->|"CPU %"| MON
    MON -->|"Trigger"| AUTO
    AUTO ==>|"Scale Out"| VM3

    %% Styling
    classDef client fill:#FEF3C7,stroke:#D97706,stroke-width:2px,color:#92400E;
    classDef lb fill:#DBEAFE,stroke:#2563EB,stroke-width:2px,color:#1E40AF;
    classDef vm fill:#DCFCE7,stroke:#16A34A,stroke-width:2px,color:#14532D;
    classDef ctrl fill:#F3E8FF,stroke:#9333EA,stroke-width:2px,color:#581C87;

    class K6 client;
    class LB lb;
    class VM1,VM2,VM3 vm;
    class AUTO,MON,GHCR ctrl;
